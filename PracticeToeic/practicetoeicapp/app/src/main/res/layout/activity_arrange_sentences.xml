<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    tools:context=".sapxepcau.ArrangeSentencesActivity">

    <LinearLayout
        android:id="@+id/arrangeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackSXC"
            style="@style/Widget.App.Button.Text"
            android:layout_width="@dimen/touch_target"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/nav_back"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/app_on_surface" />

        <TextView
            android:id="@+id/textSXC"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/practice_order"
            android:textColor="@color/app_on_surface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvScoreSXC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Điểm: 0"
            android:textColor="@color/app_on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/arrangeProgressArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/arrangeHeader">

        <TextView
            android:id="@+id/tvQuestionSXC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Câu 1/0"
            android:textColor="@color/app_on_surface_variant"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSXC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            app:indicatorColor="@color/app_primary"
            app:trackColor="@color/app_surface_variant"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/arrangeActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/arrangeProgressArea">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/card_gap"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/card_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Câu trả lời của bạn"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/editDapAn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_answer_area"
                android:clickable="false"
                android:focusable="false"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:inputType="none"
                android:minHeight="160dp"
                android:padding="20dp"
                android:textColor="@color/app_on_surface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textOption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:fontFamily="sans-serif-medium"
                android:text="Chạm vào từ để ghép câu"
                android:textColor="@color/app_on_surface_variant"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutPart1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/layoutPart2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/layoutPart3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/layoutPart4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/arrangeActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/app_surface_card"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuitSXC"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quiz_quit" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
