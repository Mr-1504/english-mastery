<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/card_gap">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.App.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="@dimen/icon_tile_size"
                android:layout_height="@dimen/icon_tile_size"
                android:background="@drawable/bg_icon_tile">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_question"
                    app:tint="@color/app_primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTenTracNghiem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="Nội dung câu trắc nghiệm"
                android:textColor="@color/app_on_surface"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/imgEditTN"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/admin_edit"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_edit"
                app:tint="@color/app_primary" />

            <ImageButton
                android:id="@+id/imgDeleteTN"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/admin_delete"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                app:tint="@color/app_error" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
