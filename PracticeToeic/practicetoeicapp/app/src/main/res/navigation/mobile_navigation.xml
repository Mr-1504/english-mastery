<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.practicetoeicapp.ui.home.HomeFragment"
        android:label="@string/nav_learn"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_practice"
        android:name="com.example.practicetoeicapp.ui.practice.PracticeFragment"
        android:label="@string/nav_practice"
        tools:layout="@layout/fragment_practice" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.practicetoeicapp.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <activity
        android:id="@+id/nav_admin"
        android:label="Quản Lý"
        android:name="com.example.practicetoeicapp.admin.AdminActivity"
        tools:layout="@layout/activity_admin" />

    <activity
        android:id="@+id/HocTuVung"
        android:label="Học từ vựng"
        android:name="com.example.practicetoeicapp.hoctuvung.HocTuVungActivity"
        tools:layout="@layout/activity_hoctuvung" />

    <activity
        android:id="@+id/DSTuVung"
        android:label="Danh sách từ vựng"
        android:name="com.example.practicetoeicapp.hoctuvung.DSTuVungActivity"
        tools:layout="@layout/activity_ds_tuvung" />

    <activity
        android:id="@+id/SapXepCau"
        android:label="Sắp xếp câu"
        android:name="com.example.practicetoeicapp.sapxepcau.SapXepCauActivity"
        tools:layout="@layout/activity_sapxepcau" />

    <activity
        android:id="@+id/ThongTinTaiKhoan"
        android:label="Thông tin tài khoản"
        android:name="com.example.practicetoeicapp.taikhoan.ThongTinTaikhoanActivity"
        tools:layout="@layout/activity_thong_tin_taikhoan" />

    <activity
        android:id="@+id/TracNghiem"
        android:label="Trắc nghiệm"
        android:name="com.example.practicetoeicapp.tracnghiem.TracNghiemActivity"
        tools:layout="@layout/activity_trac_nghiem" />

    <activity
        android:id="@+id/DienKhuyet"
        android:label="Điền khuyết"
        android:name="com.example.practicetoeicapp.dienkhuyet.DienKhuyetActivity"
        tools:layout="@layout/activity_dien_khuyet" />

    <activity
        android:id="@+id/LuyenNghe"
        android:label="Luyện nghe"
        android:name="com.example.practicetoeicapp.luyennghe.LuyenNgheActivity"
        tools:layout="@layout/activity_luyen_nghe" />

    <activity
        android:id="@+id/XepHang"
        android:label="Xếp hạng"
        android:name="com.example.practicetoeicapp.taikhoan.RankingActivity"
        tools:layout="@layout/activity_ranking" />
</navigation>
