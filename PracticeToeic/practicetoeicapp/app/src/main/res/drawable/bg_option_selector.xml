<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_primary_container" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="@color/app_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface_muted" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/app_outline_variant" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface_card" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/app_outline_variant" />
        </shape>
    </item>
</selector>
